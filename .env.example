# ==============================================================================
# SABOR & GESTIÓN - VARIABLES DE ENTORNO (PLANTILLA PARA PRODUCCIÓN Y DESARROLLO)
# ==============================================================================
# Copia este archivo como .env.local o .env para desarrollo local.
# Para despliegues en producción (Vercel, Render, Railway, Docker, etc.), configura
# estas variables en el panel de configuración de entorno del proveedor de hosting.
# ==============================================================================

# --- Conexión al Backend API (Next.js) ---
# URL base de los endpoints RESTful del backend (incluye prefijo /api)
NEXT_PUBLIC_API_URL=https://api.saborygestion.com/api

# --- Conexión WebSocket / Socket.IO en Tiempo Real (Next.js) ---
# URL del servidor Socket.IO para eventos en vivo (Pase de Cocina KDS, Mesas 3D, Caja)
NEXT_PUBLIC_SOCKET_URL=https://api.saborygestion.com

# --- Variables de Integración / Clientes Vite & Micro-frontends ---
VITE_API_URL=https://api.saborygestion.com/api
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# --- Servicios Complementarios de Notificaciones por Correo (EmailJS) ---
EMAILJS_SERVICE_ID=service_fine_dining
EMAILJS_TEMPLATE_ID=template_fine_dining
EMAILJS_USER_ID=user_public_key_mock
EMAILJS_ACCESS_TOKEN=token_access_key_mock

# --- Configuración de Puerto Local (Opcional) ---
PORT=5173
