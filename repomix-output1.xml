<file path="src/components/categorias/categoria-modal.tsx">
'use client';

import React, { useState } from 'react';
import { Categoria, CrearCategoriaDTO } from '@/types';
import { Modal } from '@/components/ui/modal';
import { Input } from '@/components/ui/input';
import { Button } from '@/components/ui/button';
import { Alert } from '@/components/ui/alert';

export interface CategoriaModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSave: (data: CrearCategoriaDTO) => Promise<void>;
  categoriaToEdit?: Categoria | null;
}

interface CategoriaFormContentProps {
  onClose: () => void;
  onSave: (data: CrearCategoriaDTO) => Promise<void>;
  categoriaToEdit?: Categoria | null;
}

const CATEGORIA_NAME_REGEX = /^[a-zA-ZáéíóúÁÉÍÓÚüÜñÑ\s]+$/;

function CategoriaFormContent({
  onClose,
  onSave,
  categoriaToEdit,
}: CategoriaFormContentProps) {
  const isEditing = !!categoriaToEdit;
  const [nombre, setNombre] = useState(categoriaToEdit?.nombre || '');
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [formError, setFormError] = useState<string | null>(null);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setFormError(null);

    const cleanNombre = nombre.trim();
    if (!cleanNombre) {
      setFormError('El nombre de la categoría es obligatorio.');
      return;
    }

    if (cleanNombre.length < 2) {
      setFormError('El nombre debe tener al menos 2 caracteres.');
      return;
    }

    if (!CATEGORIA_NAME_REGEX.test(cleanNombre)) {
      setFormError('El nombre de la categoría solo puede contener letras y espacios (sin números ni caracteres especiales).');
      return;
    }

    setIsSubmitting(true);
    try {
      await onSave({ nombre: cleanNombre });
      onClose();
    } catch (err: unknown) {
      setFormError(err instanceof Error ? err.message : 'Error al procesar la categoría.');
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-4">
      {formError && (
        <Alert variant="error" title="Error en los datos">
          {formError}
        </Alert>
      )}

      <div>
        <Input
          id="categoria-nombre"
          name="nombre"
          label="Nombre de la Categoría"
          placeholder="Ej: Entradas, Platos Fuertes, Bebidas, Postres"
          value={nombre}
          onChange={(e) => setNombre(e.target.value)}
          required
          autoFocus
          helperText="Solo se permiten letras y espacios."
        />
      </div>

      <div className="flex items-center justify-end gap-3 pt-4 border-t border-zinc-100 dark:border-zinc-800">
        <Button
          type="button"
          variant="outline"
          size="md"
          onClick={onClose}
          disabled={isSubmitting}
        >
          Cancelar
        </Button>
        <Button
          type="submit"
          variant="primary"
          size="md"
          isLoading={isSubmitting}
        >
          {isEditing ? 'Guardar Cambios' : 'Crear Categoría'}
        </Button>
      </div>
    </form>
  );
}

export function CategoriaModal({
  isOpen,
  onClose,
  onSave,
  categoriaToEdit,
}: CategoriaModalProps) {
  const isEditing = !!categoriaToEdit;

  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title={isEditing ? 'Editar Categoría' : 'Nueva Categoría del Menú'}
      description={
        isEditing
          ? 'Modifica el nombre de la categoría para organizar los platos del restaurante.'
          : 'Crea una nueva clasificación para organizar los platos en el catálogo y comandas.'
      }
      maxWidth="md"
    >
      {isOpen && (
        <CategoriaFormContent
          key={categoriaToEdit?._id || 'nueva-categoria'}
          onClose={onClose}
          onSave={onSave}
          categoriaToEdit={categoriaToEdit}
        />
      )}
    </Modal>
  );
}
</file>

<file path="src/components/dashboard/reportes-pdf.tsx">
'use client'

import { useState } from 'react'
import {
  AlertCircle,
  BarChart3,
  CalendarDays,
  CheckCircle2,
  FileDown,
  FileText,
  LoaderCircle
} from 'lucide-react'
import { ApiError } from '@/lib/api-error'
import { reporteService } from '@/services/reporte.service'

function obtenerPartesFechaBolivia(): { anio: string; mes: string; dia: string } {
  const partes = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'America/La_Paz',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
  }).formatToParts(new Date())

  return {
    anio: partes.find((parte) => parte.type === 'year')?.value ?? '2026',
    mes: partes.find((parte) => parte.type === 'month')?.value ?? '01',
    dia: partes.find((parte) => parte.type === 'day')?.value ?? '01'
  }
}

function obtenerFechaHoyBolivia(): string {
  const { anio, mes, dia } = obtenerPartesFechaBolivia()
  return `${anio}-${mes}-${dia}`
}

function obtenerInicioMesBolivia(): string {
  const { anio, mes } = obtenerPartesFechaBolivia()
  return `${anio}-${mes}-01`
}

function descargarPdfBase64(nombreArchivo: string, contenidoBase64: string): void {
  const binario = window.atob(contenidoBase64)
  const bytes = new Uint8Array(binario.length)

  for (let indice = 0; indice < binario.length; indice += 1) {
    bytes[indice] = binario.charCodeAt(indice)
  }

  const archivo = new Blob([bytes], { type: 'application/pdf' })
  const urlTemporal = URL.createObjectURL(archivo)
  const enlace = document.createElement('a')
  enlace.href = urlTemporal
  enlace.download = nombreArchivo || 'reporte-ventas-mishi-food.pdf'
  enlace.style.display = 'none'
  document.body.appendChild(enlace)
  enlace.click()
  enlace.remove()
  window.setTimeout(() => URL.revokeObjectURL(urlTemporal), 1500)
}

export function ReportesPdfSection() {
  const [desde, setDesde] = useState(obtenerInicioMesBolivia)
  const [hasta, setHasta] = useState(obtenerFechaHoyBolivia)
  const [generando, setGenerando] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [mensaje, setMensaje] = useState<string | null>(null)

  const generarReporte = async () => {
    setError(null)
    setMensaje(null)

    if (!desde || !hasta) {
      setError('Selecciona la fecha inicial y la fecha final.')
      return
    }
    if (desde > hasta) {
      setError('La fecha inicial no puede ser posterior a la fecha final.')
      return
    }

    setGenerando(true)
    try {
      const reporte = await reporteService.generarVentasPdf(desde, hasta)
      descargarPdfBase64(reporte.nombreArchivo, reporte.contenidoBase64)
      setMensaje('El reporte PDF se generó y la descarga comenzó.')
    } catch (errorDesconocido: unknown) {
      if (errorDesconocido instanceof ApiError) {
        setError(errorDesconocido.getUserMessage())
      } else {
        setError('No se pudo generar el reporte. Comprueba la conexión e inténtalo nuevamente.')
      }
    } finally {
      setGenerando(false)
    }
  }

  const claseCampo = 'mt-1 block w-full rounded-xl border border-stone-300 bg-white px-3 py-2.5 text-sm text-stone-900 shadow-sm outline-none transition focus:border-[#C84B26] focus:ring-2 focus:ring-[#C84B26]/15 dark:border-stone-700 dark:bg-stone-900 dark:text-stone-100'

  return (
    <section className="overflow-hidden rounded-2xl border border-stone-200/90 bg-white shadow-xs dark:border-stone-800 dark:bg-[#201E1B]">
      <div className="border-b border-stone-200/80 bg-stone-50/70 px-5 py-4 dark:border-stone-800 dark:bg-[#1A1816]/70 sm:px-6">
        <div className="flex items-start gap-3">
          <div className="rounded-xl border border-[#C84B26]/20 bg-[#C84B26]/10 p-2.5 text-[#C84B26] dark:text-[#E05A36]">
            <BarChart3 className="h-5 w-5" />
          </div>
          <div className="min-w-0 flex-1">
            <h2 className="text-base font-extrabold text-stone-900 dark:text-stone-50 sm:text-lg">
              Reportes de ventas
            </h2>
            <p className="mt-1 text-sm text-stone-600 dark:text-stone-400">
              Genera un solo PDF con ventas, propinas, métodos de pago, rendimiento por mesero, productos y categorías.
            </p>
          </div>
          <FileText className="hidden h-5 w-5 text-stone-400 sm:block" />
        </div>
      </div>

      <div className="space-y-5 p-5 sm:p-6">
        <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label htmlFor="reporte-desde" className="flex items-center gap-2 text-sm font-semibold text-stone-700 dark:text-stone-300">
              <CalendarDays className="h-4 w-4 text-stone-400" />
              Fecha inicial
            </label>
            <input
              id="reporte-desde"
              type="date"
              value={desde}
              max={hasta || undefined}
              onChange={(evento) => setDesde(evento.target.value)}
              className={claseCampo}
            />
          </div>
          <div>
            <label htmlFor="reporte-hasta" className="flex items-center gap-2 text-sm font-semibold text-stone-700 dark:text-stone-300">
              <CalendarDays className="h-4 w-4 text-stone-400" />
              Fecha final
            </label>
            <input
              id="reporte-hasta"
              type="date"
              value={hasta}
              min={desde || undefined}
              onChange={(evento) => setHasta(evento.target.value)}
              className={claseCampo}
            />
          </div>
        </div>

        <div className="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {[
            'Resumen de ventas y propinas',
            'Totales por método de pago',
            'Pedidos asociados a cada mesero',
            'Productos y categorías más vendidos'
          ].map((opcion) => (
            <div key={opcion} className="flex items-center gap-2 rounded-xl bg-stone-50 px-3 py-2.5 text-sm text-stone-700 dark:bg-stone-900/70 dark:text-stone-300">
              <CheckCircle2 className="h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-400" />
              <span>{opcion}</span>
            </div>
          ))}
        </div>

        {error && (
          <div role="alert" className="flex items-start gap-2 rounded-xl border border-red-200 bg-red-50 px-3 py-2.5 text-sm text-red-800 dark:border-red-900/70 dark:bg-red-950/30 dark:text-red-300">
            <AlertCircle className="mt-0.5 h-4 w-4 shrink-0" />
            <span>{error}</span>
          </div>
        )}

        {mensaje && (
          <div role="status" className="flex items-start gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2.5 text-sm text-emerald-800 dark:border-emerald-900/70 dark:bg-emerald-950/30 dark:text-emerald-300">
            <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0" />
            <span>{mensaje}</span>
          </div>
        )}

        <div className="flex flex-col justify-between gap-3 border-t border-stone-100 pt-4 dark:border-stone-800 sm:flex-row sm:items-center">
          <p className="max-w-xl text-xs leading-5 text-stone-500 dark:text-stone-400">
            El reporte usa pagos confirmados dentro del periodo seleccionado y no cambia pedidos, inventario ni cobros.
          </p>
          <button
            type="button"
            onClick={() => void generarReporte()}
            disabled={generando || !desde || !hasta}
